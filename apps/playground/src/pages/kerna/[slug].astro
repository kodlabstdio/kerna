---
import { decodeSlug, getEmDashEntry } from "emdash";
import KernaPageDocument from "../../components/KernaPageDocument.astro";

const slug = decodeSlug(Astro.params.slug);
const { entry, error, isPreview, cacheHint } = slug
  ? await getEmDashEntry("kerna_pages", slug)
  : { entry: null, error: null, isPreview: false, cacheHint: undefined };
if (!entry) Astro.response.status = error ? 500 : 404;
if (cacheHint && Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<KernaPageDocument
  title={entry?.data.title ?? "Page unavailable"}
  page={entry?.data.page}
  content={
    entry ? { collection: "kerna_pages", id: entry.data.id, slug } : undefined
  }
>
  {isPreview && <p role="status">Preview — unpublished changes</p>}
</KernaPageDocument>
