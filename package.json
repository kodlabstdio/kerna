{
  "name": "kerna",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run repo:check && vp run -r sync && vp check && vp run design:lint && vp run -r typecheck && vp run test:ci && vp run -r build",
    "test:ci": "vp run -r --concurrency-limit 1 test --bail 1 --no-file-parallelism --reporter verbose",
    "dev": "vp run playground#dev",
    "design:lint": "node scripts/lint-design.mjs DESIGN.md apps/site/DESIGN.md",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@google/design.md": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
